{
  // Deploys to https://kage-proxy.<your-subdomain>.workers.dev (the URL in src/kage/widget.js).
  "name": "kage-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "vars": { "GEMINI_MODEL": "gemini-flash-latest" },
  // Global cap: 8 messages per visitor IP per minute (Cloudflare rate limiting binding).
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  "observability": { "enabled": true }
}
